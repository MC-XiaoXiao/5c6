 #include <time.h>
 #include <hfs/hfsplus.h>
 
+static time_t hfsCurrentTime(void) {
+  const char* fixed = getenv("XPWN_HFS_FIXED_UNIX_TIME");
+  char* end;
+  long long value;
+
+  if(fixed == NULL || *fixed == '\0')
+    return time(NULL);
+
+  value = strtoll(fixed, &end, 10);
+  ASSERT(*end == '\0' && value >= 0, "invalid XPWN_HFS_FIXED_UNIX_TIME");
+  return (time_t) value;
+}
